# ─────────────────────────────────────────────────────────────
# LINK-SMART — Firebase Web Configuration
#
# These are PUBLIC client-side values (shipped in the browser bundle).
# They are NOT secrets. Leave a value blank to use the built-in
# LINK-SMART project defaults from src/firebase/config.ts.
#
# Never put service-account keys, Admin SDK credentials or private
# keys in this file.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# The owner Gmail address. It is granted Super Admin in the app and in
# firestore.rules (email fallback), and is also the address the Cloud Function
# allows to set the `superAdmin` custom claim (server env SUPER_ADMIN_EMAIL).
# Keep this value in sync with firestore.rules and functions/.env.
VITE_SUPER_ADMIN_EMAIL=ishanews7@gmail.com
